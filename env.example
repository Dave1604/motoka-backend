# ============================================
# MOTOKA BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend URL (for OAuth callbacks and email links)
FRONTEND_URL=http://localhost:3001

# Two-Factor Authentication
TOTP_ISSUER=Motoka

# Rate Limiting (Optional - defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

RESEND_API_KEY=re_resend_api_key_here
EMAIL_FROM=Motoka <no-reply@yourdomain.com>

# Email branding — must be a publicly hosted PNG/JPG (SVG is blocked by email clients)
EMAIL_LOGO_URL=https://motoka-logo.vercel.app/Logo.png

PAYSTACK_SECRET_KEY=sk_test_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_public_key_here
PAYMENT_CALLBACK_URL=http://localhost:3000/api/payment/callback


MONICREDIT_BASE_URL=https://live.backend.monicredit.com/api/v1
MONICREDIT_PUBLIC_KEY=monicredit_public_key_here
MONICREDIT_PRIVATE_KEY=monicredit_private_key_here
MONICREDIT_REVENUE_HEAD_CODE=monicredit_revenue_head_code_here
MONICREDIT_WEBHOOK_SECRET=monicredit_webhook_secret_here

# Request timeout for Monicredit API calls (in milliseconds)
# Default: 30000 (30 seconds)
MONICREDIT_REQUEST_TIMEOUT_MS=30000

# Retry configuration for Monicredit API calls
# Maximum number of retry attempts for transient failures
MONICREDIT_MAX_RETRIES=3

# Initial delay before first retry (in milliseconds)
MONICREDIT_RETRY_INITIAL_DELAY_MS=1000


LOG_LEVEL=info

# ============================================
# PAYSTACK PAYMENT URLS (Additional)
# ============================================
PAYMENT_SUCCESS_URL=http://localhost:3001/payment/success
PAYMENT_CANCEL_URL=http://localhost:3001/payment/cancel

# ============================================
# GATEWAY FAILOVER & HEALTH MONITORING
# ============================================
PRIMARY_GATEWAY=monicredit
FALLBACK_GATEWAY=paystack
GATEWAY_HEALTH_CHECK_INTERVAL_MS=30000
GATEWAY_CIRCUIT_BREAKER_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER_TIMEOUT_MS=60000

# ============================================
# CACHING CONFIGURATION (Optional)
# ============================================
# Redis URL for distributed caching (optional - uses in-memory cache if not provided)
# REDIS_URL=redis://your-redis-instance:6379

# ============================================
# CORS CONFIGURATION (REQUIRED IN PRODUCTION)
# ============================================
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://www.yourdomain.com
# In development, localhost origins are automatically allowed
# In production, only these origins will be allowed
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Allow localhost in production (for development against production backend)
ALLOW_LOCALHOST_IN_PRODUCTION=false

# ============================================
# JWT SECRET (REQUIRED FOR ADMIN AUTHENTICATION)
# ============================================
# Generate a secure secret: openssl rand -hex 64
# This is used to sign and verify admin JWT tokens
# MUST be kept secret and NEVER shared publicly
JWT_SECRET=your-jwt-secret-here

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
# Temporary directory for file uploads before processing
UPLOAD_TEMP_DIR=/tmp/motoka-uploads

# ============================================
# WHATSAPP NOTIFICATIONS (DEVELOPMENT / SANDBOX ONLY)
# ============================================
# Uses Twilio WhatsApp Sandbox for development and testing.
# All sends are gated behind WHATSAPP_REMINDERS_ENABLED — set to false to disable entirely.
#
# How to get these values:
#   1. Create a Twilio account: https://www.twilio.com/try-twilio
#   2. Go to Console > Messaging > Try it out > Send a WhatsApp message
#   3. Note your Account SID, Auth Token, and the sandbox number
#
# TODO: production migration — replace TWILIO_WHATSAPP_FROM with a verified
# WhatsApp Business number and set WHATSAPP_SANDBOX_MODE=false

# Master feature flag — false by default, set to true to enable WhatsApp sends
WHATSAPP_REMINDERS_ENABLED=false

# true = Twilio Sandbox (dev/test), false = live WhatsApp Business number (production)
WHATSAPP_SANDBOX_MODE=true

# Twilio credentials — from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Sandbox sender number (e.g. +14155238886 — the shared Twilio sandbox number)
# TODO: production migration — replace with your approved WhatsApp Business number
TWILIO_WHATSAPP_FROM=+14155238886
