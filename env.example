# ============================================
# MOTOKA BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend URL (for OAuth callbacks and email links)
FRONTEND_URL=http://localhost:3001

# Two-Factor Authentication
TOTP_ISSUER=Motoka

# Rate Limiting (Optional - defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# EMAIL SERVICE (Resend)
# ============================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email (must be verified in Resend)
EMAIL_FROM=Your App <noreply@yourdomain.com>

# ============================================
# PAYSTACK PAYMENT GATEWAY
# ============================================
# Get keys from: https://dashboard.paystack.com/#/settings/developer
# Use test keys for development, live keys for production

# Secret key (starts with sk_test_ or sk_live_)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Public key (starts with pk_test_ or pk_live_)
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Frontend URLs for payment redirects
PAYMENT_CALLBACK_URL=http://localhost:3001/payment/callback
PAYMENT_SUCCESS_URL=http://localhost:3001/payment/success
PAYMENT_CANCEL_URL=http://localhost:3001/payment/cancel
