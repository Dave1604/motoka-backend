# =============================================================
# MOTOKA BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.
# =============================================================

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Frontend URL (used in email links, OAuth redirects)
FRONTEND_URL=http://localhost:5173

# =============================================================
# SUPABASE
# Get from: Supabase dashboard → Project Settings → API
# =============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================
# CLOUDINARY
# Get from: Cloudinary dashboard → Product Environment Credentials
# =============================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =============================================================
# JWT (Admin authentication)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================
JWT_SECRET=your-128-char-hex-secret-here

# =============================================================
# CRON / EDGE FUNCTIONS
# Must match the value set in Supabase Edge Function secrets
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================
CRON_SECRET_KEY=your-cron-secret-here

# =============================================================
# EMAIL — Resend
# Get from: https://resend.com/api-keys
# =============================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Motoka <no-reply@motokaapp.ng>"
CONTACT_INBOX=trymotokaapp@gmail.com

# 2FA label shown in authenticator apps
TOTP_ISSUER=Motoka

# =============================================================
# PAYSTACK
# Dashboard: https://dashboard.paystack.com/#/settings/developer
# Use sk_test_* for dev, sk_live_* for production
# =============================================================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

PAYMENT_CALLBACK_URL=http://localhost:5173/payment/paystack/callback
PAYMENT_SUCCESS_URL=http://localhost:5173/dashboard
PAYMENT_CANCEL_URL=http://localhost:5173/licenses/renew

# =============================================================
# MONIPAY (primary hosted checkout)
# Dashboard: Settings → API Keys — https://monipay.ng/api-docs
# Amounts are always kobo (₦500.00 → 50000). Never put the private key in frontend.
# Webhook: POST /api/webhooks/monipay  header x-monipay-signature (HMAC-SHA512 of raw body)
# =============================================================
MONIPAY_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONIPAY_SECRET_KEY=pri_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Per Monipay's API docs the webhook is signed with the secret key above —
# there is no separate webhook secret. Leave blank; it falls back to
# MONIPAY_SECRET_KEY. Only set this if Monipay starts issuing a distinct one.
MONIPAY_WEBHOOK_SECRET=
MONIPAY_CALLBACK_URL=http://localhost:5173/payment/monipay/callback
PRIMARY_GATEWAY=monipay

# =============================================================
# MONICREDIT (legacy — historical rows / leftover verifies only)
# =============================================================
MONICREDIT_BASE_URL=https://live.backend.monicredit.com/api/v1
MONICREDIT_PUBLIC_KEY=PUB_LIVE_xxxxxxxxxxxx
MONICREDIT_PRIVATE_KEY=PRI_LIVE_xxxxxxxxxxxx
MONICREDIT_REVENUE_HEAD_CODE=REVxxxxxxxxxxxxxxx
MONICREDIT_WEBHOOK_SECRET=your-monicredit-webhook-secret-here

MONICREDIT_REQUEST_TIMEOUT_MS=30000
MONICREDIT_MAX_RETRIES=3
MONICREDIT_RETRY_INITIAL_DELAY_MS=1000

# WARNING: NEVER set true in production — disables webhook signature verification
SKIP_WEBHOOK_VERIFY=false

# =============================================================
# WHATSAPP — Twilio
# Get from: https://console.twilio.com
# =============================================================
WHATSAPP_REMINDERS_ENABLED=false
WHATSAPP_SANDBOX_MODE=true

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# Sandbox (dev): +14155238886 | Production: your WhatsApp Business number
TWILIO_WHATSAPP_FROM=+14155238886


# =============================================================
# SHIPBUBBLE (primary courier) — document delivery quotes + admin waybills
# Keys stay on the server. Never put these in Motoka Vite env.
# Sandbox keys: sb_sandbox_…  Live keys: sb_prod_…
# https://docs.shipbubble.com/  | https://app.shipbubble.com/
# =============================================================
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_BASE_URL=https://api.shipbubble.com/v1
SHIPBUBBLE_REQUEST_TIMEOUT_MS=20000
SHIPBUBBLE_MAX_RETRIES=2
SHIPBUBBLE_QUOTE_CACHE_MS=600000
# Live booking charges wallet — set true after funding
# SHIPBUBBLE_BOOKING_ENABLED=true
# Optional: separate webhook HMAC secret (defaults to SHIPBUBBLE_API_KEY)
# SHIPBUBBLE_WEBHOOK_SECRET=
# Live webhook URL to paste in Shipbubble dashboard:
#   https://YOUR-BACKEND-DOMAIN/api/webhooks/shipbubble
# Optional caches after first successful validate/categories call
# SHIPBUBBLE_PICKUP_ADDRESS_CODE=
# SHIPBUBBLE_CATEGORY_ID=

# Motoka office pickup — Ijebu Ode, Ogun
SHIPBUBBLE_PICKUP_STATE=Ogun
SHIPBUBBLE_PICKUP_CITY=Ijebu Ode
SHIPBUBBLE_PICKUP_STREET=Motoka office, Ijebu Ode
SHIPBUBBLE_PICKUP_LINE2=Office
SHIPBUBBLE_PICKUP_ZIP=120101
SHIPBUBBLE_PICKUP_PHONE=08000000000
SHIPBUBBLE_PICKUP_EMAIL=hello@motokaapp.ng
SHIPBUBBLE_PICKUP_FIRSTNAME=Motoka
SHIPBUBBLE_PICKUP_LASTNAME=NG
SHIPBUBBLE_DEFAULT_ZIP=120101
SHIPBUBBLE_DEFAULT_DOC_WEIGHT_KG=0.35
SHIPBUBBLE_PLATE_WEIGHT_KG=1.2
SHIPBUBBLE_DL_CARD_WEIGHT_KG=0.2

# ============================================
# SHIPBUBBLE (primary courier)
# https://docs.shipbubble.com/  | https://app.shipbubble.com/
# ============================================
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_BASE_URL=https://api.shipbubble.com/v1
# SHIPBUBBLE_BOOKING_ENABLED=true
SHIPBUBBLE_PICKUP_STATE=Ogun
SHIPBUBBLE_PICKUP_CITY=Ijebu Ode
SHIPBUBBLE_PICKUP_STREET=Motoka office, Ijebu Ode
SHIPBUBBLE_PICKUP_LINE2=Office
SHIPBUBBLE_PICKUP_ZIP=120101
SHIPBUBBLE_PICKUP_PHONE=08000000000
SHIPBUBBLE_PICKUP_EMAIL=hello@motokaapp.ng
SHIPBUBBLE_PICKUP_FIRSTNAME=Motoka
SHIPBUBBLE_PICKUP_LASTNAME=NG
SHIPBUBBLE_DEFAULT_ZIP=120101
SHIPBUBBLE_DEFAULT_DOC_WEIGHT_KG=0.35
SHIPBUBBLE_PLATE_WEIGHT_KG=1.2
SHIPBUBBLE_DL_CARD_WEIGHT_KG=0.2
